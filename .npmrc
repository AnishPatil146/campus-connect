link-workspace-packages=true
shamefully-hoist=true

# Windows MAX_PATH fix: use a short virtual store path
# Without this, pnpm's .pnpm content-addressable store paths can be 200+ chars,
# which combined with Android build intermediates (build/intermediates/cxx/Debug/...)
# exceeds the 260-char Windows MAX_PATH limit and breaks native CMake builds.
# C:/p is a Windows directory junction pointing to the actual node_modules/.pnpm dir.
# For new installs, pnpm will use C:/p/.pnpm as the store root.
virtual-store-dir=C:/p




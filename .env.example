# ==============================================================================
# Campus Connect — Production Environment Template
# ==============================================================================

# Backend (apps/api)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=30"
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
ALLOWED_ADMIN_EMAILS="admin@collegea.edu,admin@collegeb.edu,super@campusconnect.com"
REDIS_URL="rediss://default:token@host.upstash.io:6379"
CLOUDINARY_URL="cloudinary://key:secret@cloud-name"
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/campus_connect_aux?retryWrites=true&w=majority"
SINGLE_DB_MODE="true"
MULTI_DB_ENABLED="false"

# Frontend (apps/web)
NEXT_PUBLIC_API_URL="https://campus-connect-api.onrender.com/api/v1"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"

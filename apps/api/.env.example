# ─── Primary Database (Neon PostgreSQL) ───────────────────────────────────────
# Pooler URL (PgBouncer) — used at runtime. pgbouncer=true disables prepared statements
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pgbouncer=true"
# Direct (non-pooler) URL — used by Prisma for migrations only
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
ALLOWED_ADMIN_EMAILS="admin.demo@campusconnect.demo,admin@collegea.edu,admin@collegeb.edu,super@campusconnect.com"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://key:secret@cloud-name"

# ─── Operational Modes ────────────────────────────────────────────────────────
PORT=10000
NODE_ENV="production"
ENABLE_SWAGGER="true"
SINGLE_DB_MODE="true"
MULTI_DB_ENABLED="false"
ALLOWED_ORIGINS="https://campus-connect-web-tau.vercel.app,http://localhost:3000,http://localhost:3001"

# ─── Primary Database (Neon PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=30"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
ALLOWED_ADMIN_EMAILS="admin@collegea.edu,admin@collegeb.edu,super@campusconnect.com"

# ─── Redis (Cache & Session Store) ────────────────────────────────────────────
REDIS_URL="rediss://default:token@host.upstash.io:6379"

# ─── Cloudinary (Document & Media Storage) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://key:secret@cloud-name"

# ─── Auxiliary Database (MongoDB Atlas) ───────────────────────────────────────
MONGODB_ENABLED="true"
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/campus_connect_aux?retryWrites=true&w=majority"
MONGODB_DB_NAME="campus_connect_aux"

# ─── Operational Modes ────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="10000"
ENABLE_SWAGGER="true"
SINGLE_DB_MODE="true"
MULTI_DB_ENABLED="false"
ALLOWED_ORIGINS="https://campus-connect-web-tau.vercel.app,http://localhost:3000,http://localhost:3001"
